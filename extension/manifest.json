{
  "manifest_version": 3,
  "name": "Surr",
  "version": "0.1.0",
  "description": "Removes distractions from YouTube and Instagram.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["youtube.user.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram.user.js"],
      "run_at": "document_start"
    }
  ]
}
